{
  "name": "lcd",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "backend":       "pnpm --filter @lcd/backend run start:dev",
    "web":           "pnpm --filter @lcd/web run dev",
    "build:backend": "pnpm --filter @lcd/backend run build",
    "build:web":     "pnpm --filter @lcd/web run build",
    "build":         "pnpm run build:backend && pnpm run build:web",
    "lint:backend":  "pnpm --filter @lcd/backend run lint",
    "lint:web":      "pnpm --filter @lcd/web run lint"
  }
}